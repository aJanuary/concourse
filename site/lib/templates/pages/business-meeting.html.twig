{% extends 'layout.html.twig' %}
{% set platform = meeting.platform_name %}
{% set help_email_link %}<a href="mailto:{{ meeting.help_email }}">{{ meeting.help_email }}</a>{% endset %}
{% block content %}
<article>
  <h2>WSFS Business Meeting</h2>
  <p>The <a href="{{ meeting.info_url }}" target="_blank">WSFS Business Meeting</a> is held online using <a href="{{ meeting.platform_info_url }}" target="_blank">{{ platform }}</a> for audio, video and voting, and a separate Discord server for chat.{% if meeting.guide_url %} Read the <a href="{{ meeting.guide_url }}" target="_blank">guide to attending</a> before your first session.{% endif %}</p>

  <h3>Audio, video and voting</h3>
{% if join_link is not null %}
  <p>Join each session on {{ platform }} with your personal link.</p>
  <p><a href="{{ join_link }}" target="_blank" class="button">Join {{ platform }}</a></p>
  <p>Don't share this link with anyone: it lets whoever has it speak and vote as you.</p>
  <p>If you have any problems with {{ platform }}, including logging in, contact {{ help_email_link }}.</p>
{% else %}
  <div class="warn">
    <img src="/resources/warn.svg" alt="warning" aria-label="warning">
    <p>You don't currently have access to the business meeting. This may be because:</p>
    <ul>
      <li>your membership doesn't include attending the business meeting, or</li>
      <li>you joined recently and we haven't set up your access yet.</li>
    </ul>
{% if meeting.no_link_note != '' %}
    <p>{{ meeting.no_link_note }}</p>
{% endif %}
    <p>Contact {{ help_email_link }} if you think this is a mistake.</p>
  </div>
{% endif %}
{% if mpc_state is not null %}
  <h3>Mark Protection Committee election</h3>
  <p>The <a href="https://www.wsfs.org/committees/mark-protection-committee/" target="_blank">Mark Protection Committee</a> registers and protects the World Science Fiction Society's service marks. Members are elected at each year's Business Meeting.</p>
{% if join_link is null %}
  <p>You don't currently have access to the MPC election.</p>
{% elseif mpc_state == 'before' %}
  <p>The election opens on <strong>{{ mpc_opens }}</strong>.</p>
{% elseif mpc_state == 'open' %}
  <p>The election is open to everyone attending the business meeting.</p>
  <p><a href="{{ mpc_url }}" target="_blank" class="button">Vote in the MPC election</a></p>
  <p>Vote by <strong>{{ mpc_closes }}</strong>.</p>
{% else %}
  <p>The election closed on {{ mpc_closes }}.</p>
{% endif %}
{% endif %}
  <h3>Chat</h3>
  <p>Chat with other attendees during the meeting on the Business Meeting Discord server. It is separate from the convention's Discord server.</p>
{% if join_link is null %}
  <p>You don't currently have access to the Business Meeting Discord server.</p>
{% elseif discord_invite != '' %}
  <p><a href="https://discord.gg/{{ discord_invite|url_encode }}" target="_blank" class="button">Join the Business Meeting Discord</a></p>
{% else %}
  <p><strong>The Business Meeting Discord server isn't open yet. Please check back soon.</strong></p>
{% endif %}
{% if sessions %}
  <h3>Dates</h3>
  <ul>
{% for session in sessions %}
    <li>{{ session }}</li>
{% endfor %}
  </ul>
{% if meeting.duration != '' %}
  <p>{{ meeting.duration }}</p>
{% endif %}
{% endif %}
</article>
{% endblock %}
