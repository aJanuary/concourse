{# Links to the pages of a long list: include with pages = pagination(page, total_pages, params) #}
{% if pages %}
    <nav aria-label="Pages">
      <ul class="pagination">
{% if pages.previous %}
        <li><a href="{{ pages.previous }}">Previous</a></li>
{% endif %}
{% for link in pages.links %}
{% if link.gap_before %}
        <li aria-hidden="true">&hellip;</li>
{% endif %}
{% if link.current %}
        <li><a aria-current="page">{{ link.number }}</a></li>
{% else %}
        <li><a href="{{ link.url }}">{{ link.number }}</a></li>
{% endif %}
{% endfor %}
{% if pages.next %}
        <li><a href="{{ pages.next }}">Next</a></li>
{% endif %}
      </ul>
    </nav>
{% endif %}
