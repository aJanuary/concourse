{% extends 'layout.html.twig' %}
{% set title = 'Current user' %}
{% set heading = 'Is this you?' %}
{% set description = 'Who is logged in to ' ~ site.con_name ~ '.' %}
{% block content %}
<p>You are currently logged in as {{ name }}.</p>
<p><a href="/" class="button">Yes, this is me</a></p>
<p><a href="/logout">No, log them out</a></p>
{% endblock %}
