{% extends 'layouts/admin-edit.html.twig' %}
{% set title = 'Add/edit a stream URL' %}
{% set description = 'Manage stream URLs.' %}
{% set parents = {'Manage programme': '/admin/programme/list', 'Manage stream URLs': '/admin/programme/stream-urls/list'} %}
{% set crumb = heading %}
{% set action = '/admin/programme/stream-urls/edit' %}
{% set legend = 'Stream URL details' %}
{% set key = {room_id: room_id} %}
{% block fields %}
{% if not editing %}
        <p><label>Room ID: <input name="room_id" maxlength="36" required></label></p>
{% endif %}
        <p><label>Title: <input name="title" maxlength="256" value="{{ stream_url.title ?? '' }}"></label></p>
        <p><label>URL (leave empty when the room is not streaming): <input type="text" name="url" value="{{ stream_url.url ?? '' }}"></label></p>
{% endblock %}
