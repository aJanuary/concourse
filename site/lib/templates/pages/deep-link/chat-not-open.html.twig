{% extends 'layout.html.twig' %}
{% set title = 'Go to a Discord chat for an item' %}
{% set description = 'Discord chat for programme is not yet open.' %}
{% set crumb = 'Go to Discord chat for an item' %}
{% block content %}
<article>
  <h2>Programme chat not yet open</h2>
  <p>The discord chat for specific programme items is not yet open. Please check back a few days before the convention.</p>
  <p>In the meantime you can still <a href="/chat">join the {{ site.con_name }} Discord</a> to socialise with other members ahead of the convention.</p>
</article>
{% endblock %}
