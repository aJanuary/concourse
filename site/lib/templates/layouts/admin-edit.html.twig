{# An admin page that adds, edits or deletes one thing. Its PHP passes heading,
   editing (false when adding) and any errors. A page extending it sets title,
   description and parents, and
     action       where the form posts, with action=add, edit or delete
     legend       the form's legend
     key          the fields that say which thing is being edited, {name: value}
     delete_name  what the delete button asks about; the key's value if not set
   and fills the fields block. The buttons block adds to Save and Delete, and
   the scripts block goes after the form. #}
{% extends 'layout.html.twig' %}
{% import 'ui.html.twig' as ui %}
{% block content %}
{% block intro %}{% endblock %}
{% if errors ?? null %}
{{ ui.errors(errors) }}
{% endif %}
<form action="{{ action }}" method="POST" class="vertical">
  {{ csrf_field() }}
  <fieldset>
    <legend>{{ legend }}</legend>
{% if editing %}
{% for name, value in key %}
    <input type="hidden" name="{{ name }}" value="{{ value }}">
{% endfor %}
    <input type="hidden" name="action" value="edit">
{% else %}
    <input type="hidden" name="action" value="add">
{% endif %}
{% block fields %}{% endblock %}
  </fieldset>
  <input type="submit" value="Save">
{% if editing %}
  <input id="delete" type="button" value="Delete">
{% endif %}
{% block buttons %}{% endblock %}
</form>
{% if editing %}
<form id="delete-form" action="{{ action }}" method="POST" hidden>
  {{ csrf_field() }}
  <input type="hidden" name="action" value="delete">
{% for name, value in key %}
  <input type="hidden" name="{{ name }}" value="{{ value }}">
{% endfor %}
</form>
<script>
  document.getElementById('delete').addEventListener('click', function() {
    if (confirm('Are you sure you want to delete ' + {{ (delete_name ?? key|first)|json }} + '?')) {
      document.getElementById('delete-form').submit();
    }
  });
</script>
{% endif %}
{% block scripts %}{% endblock %}
{% endblock %}
