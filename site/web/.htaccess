ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^(.*)/+$ $1 [R=301,L]

  # ConClár puts the app id in the path
  RewriteRule ^api/conclar/apps/([^/]+)/selections$ api/conclar/selections.php?app_id=$1 [QSA,L]

  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule !.*\.php$ %{REQUEST_FILENAME}.php [QSA,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/epub+zip .epub
</IfModule>