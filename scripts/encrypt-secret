#!/bin/bash
#
# Encrypts a value for the secrets file, or generates an encryption key. See
# "Encrypted secrets" in docs/configuration.md.
#
#   scripts/encrypt-secret --generate-key
#   scripts/encrypt-secret                     # asks for the value
#   printf %s "$VALUE" | scripts/encrypt-secret
#
# It encrypts with the web container's key. To encrypt with another, for
# example a new key when rotating, set CONFIG_ENCRYPTION_KEY when running it.
#
set -eu -o pipefail
. "$(dirname "$0")/lib.sh"

EXEC_FLAGS=(-e HTTP_HOST=localhost)
if [ -n "${CONFIG_ENCRYPTION_KEY:-}" ]; then
	export CONFIG_ENCRYPTION_KEY
	EXEC_FLAGS+=(-e CONFIG_ENCRYPTION_KEY)
fi

if [ $# -eq 0 ]; then
	# Read here rather than as an argument, so the value isn't left in the
	# shell's history
	if [ -t 0 ]; then
		read -r -s -p "Value to encrypt: " CONFIG_SECRET_VALUE
		echo >&2
	else
		CONFIG_SECRET_VALUE=$(cat)
	fi
	export CONFIG_SECRET_VALUE
	EXEC_FLAGS+=(-e CONFIG_SECRET_VALUE)
fi

# The image's copy of scripts/ can be out of date, so send this checkout's
exec docker compose exec -T "${EXEC_FLAGS[@]}" web php -- "$@" < scripts/encrypt-secret.php
