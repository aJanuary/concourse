{# Also the set password page; kind is 'set' or 'reset' #}
{% extends 'layout.html.twig' %}
{% import 'ui.html.twig' as ui %}
{# Following an emailed link always sets a password, whichever page sent it #}
{% set title = kind == 'set' or token is not null ? 'Set password' : 'Forgot password' %}
{% set description = 'Create a new password for your account on ' ~ site.con_name ~ '.' %}
{% block content %}
<article>
  <h2>{{ title }}</h2>
{% if error is not null %}
{{ ui.error(error) }}
{% endif %}
{% if phase == 'enter-password' %}
  <form action="{{ path }}" method="POST" class="nu-form">
    {{ csrf_field() }}
    <input type="hidden" name="token" value="{{ token }}">
    <input type="hidden" name="phase" value="entered-password">
    <div class="form-group">
      <label for="email">Email</label>
      <input id="email" type="email" value="{{ email }}" autocomplete="username" disabled>
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="{{ min_password_length }}" required>
    </div>
    <div class="form-group">
      <label for="confirm_password">Confirm password</label>
      <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required>
    </div>
    <button type="submit" class="button login">Set password</button>
  </form>
{% elseif phase == 'sent' %}
  <p>If {{ email }} belongs to a member, an email has been sent to it with instructions on how to {{ kind == 'set' ? 'set a password' : 'reset your password' }}.</p>
  <p>If you do not receive an email within a few minutes, please check your spam folder or try again.</p>
  <form action="{{ path }}" method="POST">
    {{ csrf_field() }}
    <input type="hidden" name="email" value="{{ email }}">
    <input type="hidden" name="redirect" value="{{ redirect }}">
    <button type="submit" class="button login">Send another email</button>
  </form>
{% elseif token is null %}
  <form action="{{ path }}" method="POST" class="nu-form">
    {{ csrf_field() }}
    <input type="hidden" name="redirect" value="{{ redirect }}">
    <div class="form-group">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="{{ email }}" autocomplete="username" required>
    </div>
    <button type="submit" class="button login">Send email</button>
  </form>
{% endif %}
</article>
{% endblock %}
