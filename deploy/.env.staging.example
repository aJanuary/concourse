# Staging follows a branch's images, which are tagged with the branch name
# in lower case with anything other than letters, digits, ".", "_" and "-"
# replaced by "-". For example, branch feature/SSO is tagged feature-sso.
WEB_IMAGE=ghcr.io/example/member-portal-web
WEB_IMAGE_TAG=feature-sso
NGINX_IMAGE=ghcr.io/example/member-portal-nginx
NGINX_IMAGE_TAG=feature-sso

# Running alongside production on the same host needs its own containers,
# data, directory and ports
COMPOSE_PROJECT_NAME=portal-staging
PORTAL_DIR=/opt/portal-staging
PORTAL_DB_VOLUME=portal-staging-mysqldata
PORTAL_PORT=8180
PORTAL_DB_PORT=53307

# Postgres instead of MySQL; set PORTAL_DB_VOLUME to a Postgres volume too
#COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml
