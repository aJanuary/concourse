{% extends 'layout.html.twig' %}
{% set title = 'Manage sign-ups' %}
{% set description = 'Manage sign-ups.' %}
{% set parents = {'Manage programme': '/admin/programme/list'} %}
{% block content %}
  <article>
    <h2>Manage sign-ups</h2>
{% if error is not null %}
{% include 'partials/error.html.twig' with {message: error} %}
{% endif %}
{% include 'partials/admin/item-list.html.twig' with {actions: [{label: 'Add sign-up...', url: '/admin/programme/signups/edit'}, {label: 'Bulk add sign-ups...', url: '/admin/programme/signups/bulk-add'}], aria_prefix: 'Edit sign-up'} %}
  </article>
{% endblock %}
