{# Stands in for a page that isn't written yet. page is the page's name; a
   page extending this can also set its own description. #}
{% extends 'layout.html.twig' %}
{% set title = page ?: 'Under construction' %}
{% set description = description ?? 'Under construction.' %}
{% block content %}
<article>
  <h2>{{ page }}</h2>
  <p>We&apos;re still working on this page.</p>
  <p>If you are involved in testing the site, this is probably fine. If you are not, please let us know.</p>
</article>
{% endblock %}
