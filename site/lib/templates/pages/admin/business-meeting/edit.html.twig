{% extends 'layouts/admin-edit.html.twig' %}
{% set title = editing ? 'Edit link' : 'Add link' %}
{% set description = 'Manage business meeting join links.' %}
{% set parents = {'Manage business meeting': '/admin/business-meeting/list'} %}
{% set action = '/admin/business-meeting/edit' %}
{% set legend = 'Join link' %}
{% set key = {badge_no: badge_no} %}
{% set delete_name = 'the link for badge ' ~ badge_no %}
{% block fields %}
{% if not editing %}
<p><label>Badge number: <input name="badge_no" maxlength="{{ badge_max_length }}" required value="{{ badge_no }}"></label></p>
{% endif %}
<p><label>{{ platform }} join link: <input type="url" name="join_link" maxlength="{{ link_max_length }}" required pattern="https://.*" value="{{ join_link }}"></label></p>
{% endblock %}
