{# Makes the #delete button post action=delete with field=value to action, after asking #}
{% if value is not null %}
    <form id="delete-form" action="{{ action }}" method="POST" hidden>
      {{ csrf_field() }}
      <input type="hidden" name="action" value="delete">
      <input type="hidden" name="{{ field }}" value="{{ value }}">
    </form>
    <script>
      document.getElementById('delete')?.addEventListener('click', function() {
        if (confirm('Are you sure you want to delete ' + {{ value|json }} + '?')) {
          document.getElementById('delete-form').submit();
        }
      });
    </script>
{% endif %}
