#!/bin/bash
#
# Diffs two directories saved by tools/snapshot/capture, ignoring
# differences that don't change the page: whitespace between tags, attribute
# quoting and order, how characters are escaped, and the per-request CSRF
# and signed tokens. See tools/snapshot/capture.
set -eu -o pipefail

HERE=$(unset CDPATH && cd "$(dirname "$0")" && pwd)
BEFORE=$1
AFTER=$2
NORM=$(mktemp -d)
trap 'rm -rf "$NORM"' EXIT

mkdir -p "$NORM/before" "$NORM/after"
python3 -I "$HERE/normalise.py" "$BEFORE" "$NORM/before"
python3 -I "$HERE/normalise.py" "$AFTER" "$NORM/after"
diff -ru "$NORM/before" "$NORM/after" | sed "s#$NORM/##g"
