{% extends 'layouts/admin-edit.html.twig' %}
{% set title = 'Add/edit a sign-up' %}
{% set description = 'Manage sign-ups.' %}
{% set parents = {'Manage programme': '/admin/programme/list', 'Manage sign-ups': '/admin/programme/signups/list'} %}
{% set crumb = heading %}
{% set action = '/admin/programme/signups/edit' %}
{% set legend = 'Sign-up details' %}
{% set key = {id: id} %}
{% set delete_name = values.title %}
{% block fields %}
        <p><label>Title: <input name="title" maxlength="256" required value="{{ values.title }}"></label></p>
        <p><label>Category (sign-ups are grouped by this, for example "Workshop"): <input name="category" maxlength="100" required value="{{ values.category }}"></label></p>
        <p><label>Sign-up URL: <input type="url" name="url" maxlength="2048" required value="{{ values.url }}"></label></p>
        <p>Use <code>{name}</code>, <code>{email}</code> and <code>{badge_no}</code> anywhere in the URL to fill in the member's details. They are removed for members who are not logged in.</p>
        <p><label>More information URL: <input type="url" name="guide_url" maxlength="2048" value="{{ values.guide_url }}"></label></p>
        <p><label>Notes: <textarea name="notes" rows="3">{{ values.notes }}</textarea></label></p>
        <p>Times are in {{ timezone }}.</p>
        <p><label>Session start (used to group by day and time): <input type="datetime-local" name="session_start" value="{{ values.session_start }}"></label></p>
        <p><label>Sign-ups open (leave empty to open now): <input type="datetime-local" name="opens_at" value="{{ values.opens_at }}"></label></p>
        <p><label>Sign-ups close (leave empty to stay open): <input type="datetime-local" name="closes_at" value="{{ values.closes_at }}"></label></p>
{% endblock %}
