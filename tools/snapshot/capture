#!/bin/bash
#
# Saves the HTML of every page, as each kind of visitor, so a change to how
# pages are rendered can be diffed against the pages before it:
#
#   tools/snapshot/capture http://localhost:8181 /path/to/before
#   tools/snapshot/capture http://localhost:8181 /path/to/after
#   tools/snapshot/compare /path/to/before /path/to/after
#
# Point it at a scratch stack loaded with tools/snapshot/seed.sql, never at a
# real database, and reload the seed before each capture. Logging in uses
# the dev provider.
set -eu -o pipefail

BASE=$1
OUT=$2
mkdir -p "$OUT"
JARS=$(mktemp -d)
trap 'rm -rf "$JARS"' EXIT

PUBLIC=(
  / /login '/login?error_code=unknown-member' '/login?provider=dev' '/login?provider=local'
  /help /site-map /attributions /privacy-policy /login-instructions /discord-instructions
  /convention-guide /convention-time /maps /times /newsletter /programme-guide
  /under-construction '/under-construction?page=Gallery' /virtual-gatherings
  /upload-photo /upload-presentation /forgot-password '/forgot-password?sent=1&email=a%40example.com'
  '/forgot-password?error=invalid-token' /set-password /password-prompt /does-not-exist
  /guides/list /guides/moderator /guides/online /guides/participant
)
MEMBER=(
  /profile '/profile?error=mismatch' '/profile?password_changed=1' /switch-member
  /chat /stream /sign-ups /site-selection '/site-selection?success=1' /site-selection/details
  /site-selection/processing /business-meeting '/chat_tab?room_id=r1'
  '/deep-link/chat?item_id=100' '/deep-link/chat?room_id=r1' '/deep-link/participate?item_id=100'
  '/deep-link/replay?item_id=100' '/deep-link/replay?item_id=101' '/deep-link/session?item_id=100'
  '/deep-link/stage?room_id=r1' '/deep-link/stream?room_id=r1' '/deep-link/replay?item_id=nope'
)
ADMIN=(
  /admin/discord /admin/login-sessions /admin/programme-reports
  /admin/programme-reports/favourites '/admin/programme-reports/favourites?app_id=nope'
  /admin/roles '/admin/roles?role_id=2' /admin/roles/edit-member-roles
  '/admin/roles/edit-member-roles?q=adm' '/admin/roles/edit-member-roles?badge_no=a001'
  '/admin/roles/edit-member-roles?badge_no=a001&status=added&role_id=2'
  /admin/programme/list /admin/programme/sessions/list '/admin/programme/sessions/edit?item_id=100'
  /admin/programme/sessions/edit /admin/programme/stages/list '/admin/programme/stages/edit?room_id=r1'
  /admin/programme/stages/edit /admin/programme/stream-urls/list '/admin/programme/stream-urls/list?error=x'
  '/admin/programme/stream-urls/edit?room_id=r1' /admin/programme/stream-urls/edit
  /admin/programme/replay/list '/admin/programme/replay/edit?item_id=100'
  '/admin/programme/replay/edit?title=T%26&replay_url=https%3A%2F%2Fexample.com' /admin/programme/replay/edit
  /admin/programme/discord-posts/list '/admin/programme/discord-posts/edit?item_id=100'
  /admin/programme/discord-posts/edit /admin/programme/signups/list '/admin/programme/signups/list?error=x'
  '/admin/programme/signups/edit?id=1' /admin/programme/signups/edit /admin/programme/signups/bulk-add
  /admin/programme/zoom/edit
  /admin/business-meeting/list '/admin/business-meeting/list?done=1&badge_no=a001'
  '/admin/business-meeting/edit?badge_no=a001' /admin/business-meeting/edit /admin/business-meeting/upload
  /admin/site-selection/list '/admin/site-selection/list?search=TOKEN&sort=label&dir=desc'
  '/admin/site-selection/list?count=3&added=2&done=1&skipped=1' /admin/site-selection/add
  /admin/site-selection/desk '/admin/site-selection/desk?search=adm' '/admin/site-selection/desk?message=sold&badge_no=a001'
  /admin/site-selection/spoilt /admin/site-selection/export
)

fetch() {
  local who=$1 path=$2
  local name
  name=$(printf '%s' "$who$path" | tr -c 'A-Za-z0-9._-' '_')
  curl --silent --show-error --cookie "$JARS/$who" --cookie-jar "$JARS/$who" \
    --write-out '\n<!-- status %{http_code} %{redirect_url} -->\n' \
    --output "$OUT/$name.html" "$BASE$path" >>"$OUT/$name.html"
}

login() {
  local who=$1 badge_no=$2
  local page token
  page=$(curl --silent --cookie "$JARS/$who" --cookie-jar "$JARS/$who" "$BASE/login?provider=dev")
  token=$(printf '%s' "$page" | sed -n 's/.*name="csrf_token" value="\([0-9a-f]*\)".*/\1/p' | head -n 1)
  curl --silent --output /dev/null --cookie "$JARS/$who" --cookie-jar "$JARS/$who" \
    --data-urlencode "csrf_token=$token" --data-urlencode "badge_no=$badge_no" --data-urlencode 'redirect=/' \
    "$BASE/login?provider=dev"
}

# Fetches a page's output into the file, after curl's own write-out
fetch_all() {
  local who=$1; shift
  for path in "$@"; do
    fetch "$who" "$path"
  done
}

fetch_all nobody "${PUBLIC[@]}" "${MEMBER[@]}"

curl --silent --output /dev/null --cookie-jar "$JARS/anon" "$BASE/login?skip-login"
fetch_all anon "${PUBLIC[@]}" "${MEMBER[@]}"

login member m002
fetch_all member "${PUBLIC[@]}" "${MEMBER[@]}" "${ADMIN[@]}"

login admin a001
fetch_all admin "${PUBLIC[@]}" "${MEMBER[@]}" "${ADMIN[@]}"

echo "Saved $(ls "$OUT" | wc -l | tr -d ' ') pages to $OUT"
