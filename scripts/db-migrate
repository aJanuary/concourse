#!/bin/bash
#
# Runs Phinx in the web container. With no arguments it applies any pending
# migrations; otherwise the arguments are a Phinx command:
#
#   scripts/db-migrate
#   scripts/db-migrate create MigrationName
#   scripts/db-migrate status
#   scripts/db-migrate rollback
#
set -eu -o pipefail
. "$(dirname "$0")/lib.sh"

if [ $# -eq 0 ]; then
	set -- migrate
fi

# Plain "${EXEC_FLAGS[@]}" fails under set -u in macOS bash 3.2 when empty
EXEC_FLAGS=()
if [ ! -t 0 ]; then
	EXEC_FLAGS+=(-T)
fi

exec docker compose exec ${EXEC_FLAGS[@]+"${EXEC_FLAGS[@]}"} -w /var/php-migrations web vendor/bin/phinx "$@"
