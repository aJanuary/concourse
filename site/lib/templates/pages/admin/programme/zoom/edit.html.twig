{% extends 'layout.html.twig' %}
{% set title = 'Manage Zoom link' %}
{% set description = 'Manage Zoom link.' %}
{% set parents = {'Manage programme': '/admin/programme/list'} %}
{% set crumb = 'Edit Zoom link' %}
{% block content %}
  <article>
    <h2>Edit Zoom link</h2>
    <form action="/admin/programme/zoom/edit" method="POST" class="vertical">
      {{ csrf_field() }}
      <fieldset>
        <legend>Zoom link</legend>
        <p><label>Zoom URL: <input name="zoom_url" value="{{ zoom_url }}"></label></p>
      </fieldset>
      <input type="submit" value="Save">
    </form>

    <script>
      if (window.location.search.includes('error')) {
          var $toast = document.createElement('p');
          $toast.role = 'alert';
          $toast.id = 'error-toast';
          $toast.textContent = 'Error: ' + new URLSearchParams(window.location.search).get('error');
          $toast.addEventListener('click', e => {
            e.target.remove();
          });
          document.body.appendChild($toast);
          window.history.replaceState({}, document.title, window.location.pathname);
        }
    </script>
  </article>
{% endblock %}
