# Production follows the images published from the default branch, which
# are tagged latest. Replace example/concourse with the GitHub
# repository the images are built from, in lower case.
WEB_IMAGE=ghcr.io/example/concourse-web
WEB_IMAGE_TAG=latest
NGINX_IMAGE=ghcr.io/example/concourse-nginx
NGINX_IMAGE_TAG=latest

# The rest are optional; these are the defaults.

# Postgres instead of MySQL
#COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml

# The directory holding secrets/ and analytics/
#PORTAL_DIR=/opt/portal
# The database volume; portal-pgdata on Postgres
#PORTAL_DB_VOLUME=portal-mysqldata
# Host ports, bound to 127.0.0.1. The database port is 55432 on Postgres
#PORTAL_PORT=8080
#PORTAL_DB_PORT=53306
