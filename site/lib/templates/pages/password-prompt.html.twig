{% extends 'layout.html.twig' %}
{% set title = 'Set a password' %}
{% set heading = 'Would you like to set a password?' %}
{% set description = 'Choose whether to set a password for ' ~ site.con_name ~ '.' %}
{% block content %}
<p>You are logged in with a code sent to {{ email }}. If you set a password, you can use it to log in next time instead of waiting for a code.</p>
<p>We will email you a link to choose your password.</p>
<form action="/set-password" method="post">
  {{ csrf_field() }}
  <input type="hidden" name="email" value="{{ email }}">
  <input type="hidden" name="redirect" value="{{ redirect }}">
  <button type="submit" class="button">Email me a link to set a password</button>
</form>
<form action="/password-prompt" method="post">
  {{ csrf_field() }}
  <input type="hidden" name="redirect" value="{{ redirect }}">
  <button type="submit" class="button link">No thanks, don't ask again</button>
</form>
<p>You can set a password later from your profile.</p>
{% endblock %}
