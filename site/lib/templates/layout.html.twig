{# Every portal page extends this and fills the content block, and may add to
   head and body_class. A page sets, before its blocks:
     title        shown after the portal's name in the browser tab and as the
                  last breadcrumb; none on the home page, which has no breadcrumbs
     description  the meta description
     parents      the breadcrumbs between Home and this page, {name: url}
     crumb        the last breadcrumb, when it isn't the title #}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description }}">
    <title>{{ site.con_name }} Member Portal{% if title ?? null %} - {{ title }}{% endif %}</title>
    <link rel="shortcut icon" href="/resources/favicon.png">
    <link rel="stylesheet" href="{{ asset('/resources/reset.css') }}">
    <link rel="stylesheet" href="{{ asset('/resources/style.css') }}">
    <script src="{{ asset('/resources/dropdown.js') }}" defer></script>
    <script src="{{ asset('/resources/form.js') }}" defer></script>
{% block head %}{% endblock %}
  </head>
  <body{% if block("body_class") is not empty %} class="{% block body_class %}{% endblock %}"{% endif %}>
    <header>
      <div class="container">
        <a href="/" class="site-branding-container" rel="home">
          <div class="site-logo">
            <img width="36" height="36" src="/resources/logo-2x.webp" srcset="/resources/logo-1x.webp 1x, /resources/logo-1.5x.webp 1.5x, /resources/logo-2x.webp 2x" alt="">
          </div>
          <div class="site-branding">
            <hgroup>
              <h1>{{ site.con_short_name }}</h1>
              <p>Member portal</p>
            </hgroup>
          </div>
        </a>
{% if site.user %}
        <div class="username">
{% if site.user.anonymous %}
          <a href="{{ site.user.login_link }}">Log in</a>
{% else %}
          <div id="user-dropdown">
            <input type="checkbox" id="user-menu-toggle" role="button" aria-haspopup="true" aria-controls="user-dropdown-menu">
            <label for="user-menu-toggle" id="user-menu-label">{{ site.user.name }}</label>
            <div id="user-dropdown-menu" role="menu">
              <a href="/profile" role="menuitem">Profile</a>
{% if site.user.can_switch %}
              <a href="/switch-member?redirect={{ site.request_uri|url_encode }}" role="menuitem">Switch member</a>
{% endif %}
              <a href="/logout" role="menuitem">Log out</a>
            </div>
          </div>
{% endif %}
        </div>
{% endif %}
      </div>
    </header>
    <main>
{% if title ?? null %}
      <nav class="breadcrumbs">
        <ul>
          <li><a href="/">Home</a></li>
{% for name, url in parents ?? {} %}
          <li><a href="{{ url }}">{{ name }}</a></li>
{% endfor %}
          <li>{{ crumb ?? title }}</li>
        </ul>
      </nav>
{% endif %}
{% block content %}{% endblock %}
    </main>
    <footer>
      <div class="container">
        <p>&copy; {{ site.year }} {{ site.con_short_name }}</p>
        <ul>
          <li><a href="/help">Help</a></li>
          <li><a href="/site-map">Site map</a></li>
          <li><a href="/attributions">Icon attributions</a></li>
          <li><a href="/privacy-policy">Privacy policy</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
