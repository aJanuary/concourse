{# A form's errors: include with errors, and optionally intro #}
    <div class="error">
      <img src="/resources/error.svg" alt="error" aria-label="error">
{% if intro ?? null %}
      <p>{{ intro }}</p>
{% endif %}
      <ul>
{% for error in errors %}
        <li>{{ error }}</li>
{% endfor %}
      </ul>
    </div>
